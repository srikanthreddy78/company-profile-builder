# ---- Provider credentials (required for live runs) ----------------------------------
OPENAI_API_KEY=sk-...
FIRECRAWL_API_KEY=fc-...

# ---- Limits (one variable each; CLI flags override) ---------------------------------
# Max unique pages to scrape per run (default 10). Raising this also raises the derived
# scrape-call and model-call caps.
PROFILE_BUILDER_MAX_PAGES=10
# Max interview questions including follow-ups (default 5).
PROFILE_BUILDER_MAX_QUESTIONS=5

# ---- Model ---------------------------------------------------------------------------
# Tier: fast (gpt-5-mini) or quality (gpt-5.4). --model overrides with an explicit id.
PROFILE_BUILDER_TIER=fast
# PROFILE_BUILDER_MODEL=gpt-5.4-mini
# Hybrid retrieval: embedding model (default text-embedding-3-small); set
# PROFILE_BUILDER_USE_EMBEDDINGS=false for keyword-only search (--no-embeddings).
# PROFILE_BUILDER_EMBEDDING_MODEL=text-embedding-3-small
PROFILE_BUILDER_USE_EMBEDDINGS=true

# ---- Cost / network -------------------------------------------------------------------
# Optional estimated-spend cap in USD. Unset = unlimited (cost is still tracked).
# PROFILE_BUILDER_BUDGET_USD=1.00
PROFILE_BUILDER_SCRAPE_TIMEOUT_MS=30000
PROFILE_BUILDER_MAX_RETRIES=2

# ---- Paths ---------------------------------------------------------------------------
PROFILE_BUILDER_RUNS_DIR=.runs
# Console verbosity is set with the global flags: python -m profile_builder -v|-q <command>

# ---- Optional tracing (standard LangSmith variables) ---------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=company-profile-builder
